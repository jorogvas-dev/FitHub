POSTGRES_USER=fithub
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
POSTGRES_DB=fithub
SECRET_KEY=GENERATE_WITH_SETUP_SCRIPT
WEB_PORT=8010
HTTPS_PORT=8443
DOZZLE_PORT=8088
POSTGRES_HOST_PORT=5433
WORKOUT_AI_ENDPOINT=http://host.docker.internal:3000/api/chat/completions
WORKOUT_AI_MODEL=qwen2.5-7b-nerd-uncensored-v1.0
# Workout generation does not use the document/task planner tool.
WORKOUT_AI_TOOL_IDS=
WORKOUT_AI_TIMEOUT_SECONDS=120
# Store the Open WebUI API key in ignored .secrets/openwebui-api-key.txt, not here.
# Separate nutrition preset ID; verify with `flask --app app nutrition-models`.
NUTRITION_AI_MODEL=fithub-coach
