# Local settings and credentials. The root template contains placeholders only.
.env
.env.*
*.env
*.env.*
!/.env.example
.secrets/
secrets/
credentials/
credentials.json
*.credentials.json
.netrc
.npmrc
.pypirc

# Local certificates and private keys (generated in Docker volumes).
certs/
certificates/
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.csr
*.jks
*.keystore
id_rsa*
id_ed25519*

# Database dumps and local database/vector-store state.
# Only versioned schema/seed migrations are publishable SQL.
*.sql
!/db/init/[0-9][0-9]-*.sql
!/db/migrations/[0-9][0-9][0-9]_*.sql
*.sql.*
*.dump
*.dump.*
*.backup
*.bak
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
pgdata/
postgres-data/
chromadata/
chroma-data/
tlsdata/
backups/
dumps/
exports/
*_export.*
*-export.*

# Private trainer documents, personal records and uploads.
*.[pP][dD][fF]
*.doc
*.docx
*.xls
*.xlsx
*.xlsm
*.ods
*.csv
*.tsv
*.har
private/
personal/
personal-data/
user-data/
trainer-pdfs/
trainer_pdfs/
trainer-documents/
uploads/
user_uploads/
/data/

