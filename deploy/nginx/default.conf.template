# Docker's embedded DNS tracks all containers of the scaled web service.
resolver 127.0.0.11 valid=2s ipv6=off;
resolver_timeout 2s;

upstream fithub_web {
    zone fithub_web 64k;
    server web:8000 resolve max_fails=1 fail_timeout=3s;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name localhost;
    return 308 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name localhost;
    ssl_certificate /etc/nginx/certs/localhost.crt;
    ssl_certificate_key /etc/nginx/certs/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    server_tokens off;

    # Readiness tests TLS without consuming the web round-robin sequence.
    location = /proxy-health {
        access_log off;
        return 200 'nginx ready\n';
    }

    location / {
        proxy_pass http://fithub_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port ${HTTPS_PORT};
        proxy_cookie_flags session secure httponly samesite=lax;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        # Retry failed connections/GETs. Do not enable non_idempotent POST replay.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 5s;
        add_header X-FitHub-Upstream $upstream_addr always;
    }
}
