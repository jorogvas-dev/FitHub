# Docker's embedded DNS tracks all containers of the scaled web service.
resolver 127.0.0.11 valid=2s ipv6=off;
resolver_timeout 2s;

upstream fithub_web {
    zone fithub_web 64k;
    server web:8000 resolve max_fails=1 fail_timeout=3s;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name localhost;
    return 308 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name localhost;
    ssl_certificate /etc/nginx/certs/localhost.crt;
    ssl_certificate_key /etc/nginx/certs/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    server_tokens off;
    set $fithub_forwarded_port ${HTTPS_PORT};

    # Readiness tests TLS without consuming the web round-robin sequence.
    location = /proxy-health {
        access_log off;
        return 200 'nginx ready\n';
    }

    # The app caps inference at 180 seconds. Leave room to render its own timeout error.
    location = /plans/generate {
        include /etc/nginx/fithub-proxy.conf;
        proxy_read_timeout 195s;
    }

    location ~ ^/workouts/[0-9]+/review$ {
        include /etc/nginx/fithub-proxy.conf;
        proxy_read_timeout 195s;
    }

    location = /nutrition/meal-plans/ai {
        include /etc/nginx/fithub-proxy.conf;
        proxy_read_timeout 195s;
    }

    location ~ ^/nutrition/meal-plans/[0-9]+/meals/[0-9]+/swap$ {
        include /etc/nginx/fithub-proxy.conf;
        proxy_read_timeout 195s;
    }

    location / {
        include /etc/nginx/fithub-proxy.conf;
        proxy_read_timeout 30s;
    }
}
